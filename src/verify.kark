// Integration verification for the Karkain-DataFramework public API.
import dataframework

func main() {
    let p = new_pipeline("scale")
    p = add_stage(p, "increment")
    p = add_stage(p, "double")
    let d = add_value(add_value(new_dataset(), 1), 5)
    let out = run_pipeline(p, d)

    assert_eq(stage_count(p), 2)
    assert_eq(out[0], 4)
    assert_eq(out[1], 12)
    println(describe_pipeline(p))
}
